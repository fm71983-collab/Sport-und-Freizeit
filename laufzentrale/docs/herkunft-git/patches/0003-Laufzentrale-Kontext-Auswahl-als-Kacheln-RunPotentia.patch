+// Das Profil wird automatisch aus Coros übernommen und ohne Neuladen in die App gespielt.
+// Wer es direkt in RunPotential ändert, behält seine Werte, bis er „Mit Coros abgleichen“ tippt.
+const RP_KEY = "runPotentialProfile";
+// Vergleich nur nach Inhalt, weil RunPotential das Profil beim Speichern neu formatiert
+const rpSig = p => p ? JSON.stringify([(p.perfs || []).map(x => [Number(x.dist).toFixed(3), Math.round(x.time)]).sort((a, b) => a[0].localeCompare(b[0]) || a[1] - b[1]),
+  +p.age || 0, +p.weight || 0, p.gender || "", +p.weeklyKm || 0, +p.longrunKm || 0]) : "";
+const rpStored = () => { try { return JSON.parse(lsGet(RP_KEY) || "null"); } catch { return null; } };
+const rpWin = () => { try { return $("rpFrame").contentWindow; } catch { return null; } };
+function rpStatus(lvl, text, btn) { $("rpDot").className = "rp-dot " + lvl; $("rpInfo").textContent = text; $("rpInfo").title = text; $("rpSync").hidden = !btn; }
+function syncRunPotential(force) {
+  if (!S.dbReady || !S.records) { rpStatus("", "Profil wird übernommen, sobald Coros-Daten und Rennen geladen sind …"); return; }
+  const prof = rpProfile(); const sig = rpSig(prof);
+  if (!prof.perfs.length) { rpStatus("warn", "Noch keine Rennergebnisse im Prognosemodell. Trage sie unter „Rennen“ ein."); return; }
+  const cur = rpStored(); const last = lsGet("lz-rp-sig");
+  // eigene Änderungen: gespeichertes Profil weicht vom zuletzt übernommenen ab (ohne Vermerk: nur wenn es nie übernommen wurde)
+  const own = cur && rpSig(cur) !== sig && (last != null ? rpSig(cur) !== last : !lsGet("lz-rp-synced"));
+  if (own && !force) { rpStatus("warn", "Eigene Werte in RunPotential aktiv, nicht die aktuellen Coros-Daten", true); return; }
+  if (!cur || rpSig(cur) !== sig) {
+    lsSet("runPotentialSeen", "1");
+    if (!lsSet(RP_KEY, JSON.stringify(prof))) { rpStatus("warn", "Dein Browser blockiert den lokalen Speicher, das Profil kann nicht übernommen werden."); return; }
+    const w = rpWin(); if (w && typeof w.loadProfile === "function") { try { w.loadProfile(); } catch {} }
+  }
+  lsSet("lz-rp-sig", sig); lsSet("lz-rp-synced", TODAY);
+  rpStatus("good", `Mit deinen Coros-Daten · ${prof.perfs.length} Rennen · Ø ${prof.weeklyKm} km/Woche · längster Lauf ${prof.longrunKm} km`);
 }
+let rpInit = false;
 function initRunPotential() {
   if (rpInit) return; rpInit = true;
