+// Im Hintergrund vorladen, sobald die Daten da sind, damit der Wechsel in den Bereich sofort klappt
+function rpReady() {
+  if (!S.dbReady || !S.records) return;
+  if (rpInit) { syncRunPotential(false); return; }
+  (window.requestIdleCallback || (f => setTimeout(f, 800)))(initRunPotential);
+}
+// Die App füllt den Bildschirm bis zur Tab-Leiste, damit nur sie selbst scrollt
+function sizeRp() {
