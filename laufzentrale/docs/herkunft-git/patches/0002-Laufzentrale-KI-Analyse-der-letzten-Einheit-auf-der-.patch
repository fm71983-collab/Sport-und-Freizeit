+  const longs = recs.filter(x => x.isRun && x.dist >= 18).map(x => `${x.date} ${km1(x.dist)} km ${fmtP(x.pace)}/km Puls ${x.hr || "–"}`);
+  return `Letzte 3 Monate (Coros):\n${weeks.join("\n")}\nTempo und Puls je Monat (Läufe ab 5 km):\n${trend.join("\n") || "–"}\nLange Läufe ab 18 km: ${longs.join("; ") || "keine"}`;
