+}
+function rollWeekCtx(end) {
+  const from = addDays(end, -6); const lines = []; let km = 0, sec = 0, n = 0;
+  for (let d = from; d <= end; d = addDays(d, 1)) {
+    const p = S.plan[d]; const acts = (S.records || []).filter(x => x.date === d && (x.dur >= 300 || x.dist >= 1));
+    acts.forEach(x => { if (x.isRun) km += x.dist; sec += x.dur; n++; });
+    lines.push(`${WD[parseIso(d).getDay()]} ${d}: Plan ${p ? `${p.title} (${TYPE_LABEL[p.type]}, ${p.km || 0} km)` : "–"}; gemacht: ${acts.length ? acts.map(actTxt).join(", ") : "nichts"}`);
+  }
+  const l = S.load && (S.load[end] || S.load[latestKey(S.load)]);
+  const hrv = S.hrv ? Object.keys(S.hrv).filter(k => k >= from && k <= end).sort().map(k => `${k.slice(5)}: ${S.hrv[k].avg}`).join(", ") : "";
+  return `Rollierende Trainingswoche ${from} bis ${end}: ${km1(km)} Lauf-km, ${nf(sec / 3600, 1)} h, ${n} Einheiten${l ? `; Belastung kurzfristig ${l.st}, langfristig ${l.lt}, Quote ${nf(l.ratio, 2)} (${trLoad(l.comment)})` : ""}${hrv ? `; HRV in ms ${hrv}` : ""}.\n${lines.join("\n")}`;
+}
+function planCtx(a) {
+  const PH = getPhases(); const cur = PH.find(p => p.from <= a.date && p.to >= a.date); const next = PH.find(p => p.from > a.date);
+  const c = compliance(PLAN_START, TODAY);
+  const weeks = [];
+  for (let i = -3; i <= 2; i++) { const mon = addDays(mondayOf(a.date), 7 * i); const ws = weekStats(mon); if (ws.plannedAll || ws.done) weeks.push(`ab ${mon}: geplant ${km1(ws.plannedAll)} km, gelaufen ${km1(ws.done)} km`); }
+  const ahead = [];
+  for (let d = addDays(a.date, 1), i = 0; i < 14; d = addDays(d, 1), i++) { const p = S.plan[d]; if (p) ahead.push(`${WD[parseIso(d).getDay()]} ${d}: ${p.title} (${TYPE_LABEL[p.type]}, ${p.km || 0} km${p.paceFrom ? `, Pace ${p.paceFrom}–${p.paceTo || ""}` : ""})`); }
+  return `Trainingsplan: aktuelle Phase ${cur ? `„${cur.name}“ (${cur.from} bis ${cur.to})` : "keine"}${next ? `, danach „${next.name}“ ab ${next.from}` : ""}. Planerfüllung seit ${PLAN_START}: ${c.score == null ? "–" : nf(c.score * 100) + " %"} (Umfang ${c.vol == null ? "–" : nf(c.vol * 100) + " %"}, Schlüsseleinheiten ${c.keysDone}/${c.keys}).\nWochenumfänge: ${weeks.join("; ") || "–"}\nGeplant in den 14 Tagen nach der Einheit:\n${ahead.join("\n") || "nichts geplant"}`;
+}
+function m3Ctx() {
+  const recs = (S.records || []).filter(x => x.dur >= 300 || x.dist >= 1); const weeks = [];
+  for (let i = 11; i >= 0; i--) {
+    const mon = addDays(mondayOf(TODAY), -7 * i), sun = addDays(mon, 6);
+    const w = recs.filter(x => x.date >= mon && x.date <= sun); const runs = w.filter(x => x.isRun);
+    const other = w.filter(x => !x.isRun).reduce((s, x) => s + x.dur, 0) / 3600;
+    weeks.push(`ab ${mon}: ${km1(runs.reduce((s, x) => s + x.dist, 0))} km in ${runs.length} Läufen, längster ${km1(Math.max(0, ...runs.map(x => x.dist)))} km${other >= 0.2 ? `, dazu ${nf(other, 1)} h Rad/Sonstiges` : ""}`);
+  }
+  const months = {}; recs.filter(x => x.isRun && x.hr && x.pace && x.dist >= 5).forEach(x => { (months[x.date.slice(0, 7)] = months[x.date.slice(0, 7)] || []).push(x); });
